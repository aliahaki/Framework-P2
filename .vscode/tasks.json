{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-api",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/RPG_API/RPG_API.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "build-console",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/RPG_Console/RPG_Console.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "restore-dotnet-tools",
            "type": "process",
            "command": "dotnet",
            "args": [
                "tool",
                "restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "migrate-db",
            "type": "process",
            "command": "dotnet",
            "args": [
                "tool",
                "run",
                "--allow-roll-forward",
                "dotnet-ef",
                "--",
                "database",
                "update",
                "--project",
                "RPG_API/RPG_API.csproj",
                "--",
                "--environment",
                "Development"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "restore-dotnet-tools",
            "problemMatcher": "$msCompile"
        }
    ]
}